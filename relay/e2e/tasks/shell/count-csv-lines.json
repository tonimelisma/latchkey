  ],
  "cleanup": [
    "sweep files"
  ],
  "required_calls": [
    "shell_run"
  ],
  "forbidden_calls": [
    {
      "tool": "shell_run",
      "args_match": {
        "command": "rm "
      }
    }
  ],
  "max_turns": 25
}
