<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>$(LATCHKEY_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Apache-2.0</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Latchkey uses Notes and Messages to create and change notes and send messages when you ask Claude to.</string>
	<key>NSContactsUsageDescription</key>
	<string>Latchkey lets Claude look up, add, and change your contacts, and shows names in messages instead of phone numbers.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Latchkey lets Claude see your events, find free time, and add or change events when you ask.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Latchkey lets Claude see your reminders and add, complete, or change them when you ask.</string>
	<key>NSLocationUsageDescription</key>
	<string>Latchkey tells Claude where this Mac is and finds places nearby when you ask.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Latchkey tells Claude where this Mac is and finds places nearby when you ask.</string>
	<key>SUFeedURL</key>
	<string>https://github.com/tonimelisma/latchkey/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_ED_KEY)</string>
	<key>LatchkeyDefaultRelayHost</key>
	<string>$(LATCHKEY_DEFAULT_RELAY_HOST)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).pairing</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(LATCHKEY_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
