.DS_Store

# Go
/relay/bin/
*.test
*.out

# Relay local data
/relay/data/
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example

# Keys, certificates, provisioning profiles and installers never belong here
*.pem
*.p8
*.p12
*.mobileprovision
*.dmg

# Security scanner reports at the top of the checkout (they quote findings; relay/Makefile keeps
# them out of scans too). Anchored: .claude/claude-security-guidance.md is a tracked file.
/CLAUDE-SECURITY-*

# Xcode (project is generated by XcodeGen from macos/project.yml)
*.xcodeproj/
xcuserdata/
DerivedData/
*.xcuserstate
build/

# Per-developer signing and defaults (DEVELOPMENT_TEAM, LATCHKEY_DEFAULT_RELAY_HOST)
macos/Config/Local.xcconfig

# Personal notes for Claude Code (deployment details stay out of the repository)
CLAUDE.local.md

__pycache__/

# Claude Code worktrees (one per session or task)
.claude/worktrees/
