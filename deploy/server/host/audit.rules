## Latchkey: audit rules for the relay's server (deploy/harden.sh installs them as
## /etc/audit/rules.d/latchkey.rules). The sentinel (sentinel.py) reads every event keyed "lk_"
## and reports any not made in the owner's own SSH session or by a package update.
-D
-b 8192
--backlog_wait_time 60000
-f 1

## The relay's key file and settings, the shared web server's settings, the apps' compose files
-w /opt/latchkey -p wa -k lk_relay
-w /opt/reverse-proxy -p wa -k lk_caddy
-w /opt/hackernews/docker-compose.yml -p wa -k lk_apps
-w /opt/hackernews/.env -p wa -k lk_apps

## Who may sign in and become root
-w /etc/ssh/sshd_config -p wa -k lk_sshd
-w /etc/ssh/sshd_config.d -p wa -k lk_sshd
-w /etc/sudoers -p wa -k lk_sudoers
-w /etc/sudoers.d -p wa -k lk_sudoers
-w /etc/passwd -p wa -k lk_accounts
-w /etc/shadow -p wa -k lk_accounts
-w /etc/group -p wa -k lk_accounts
-w /etc/gshadow -p wa -k lk_accounts
-w /root/.ssh -p wa -k lk_ssh_keys
-w /home/tonimelisma/.ssh -p wa -k lk_ssh_keys
-w /home/ubuntu/.ssh -p wa -k lk_ssh_keys
-w /etc/pam.d -p wa -k lk_pam
-w /etc/security -p wa -k lk_pam
-w /etc/nsswitch.conf -p wa -k lk_pam

## What starts by itself
-w /etc/crontab -p wa -k lk_cron
-w /etc/cron.d -p wa -k lk_cron
-w /etc/cron.hourly -p wa -k lk_cron
-w /etc/cron.daily -p wa -k lk_cron
-w /etc/cron.weekly -p wa -k lk_cron
-w /etc/cron.monthly -p wa -k lk_cron
-w /var/spool/cron -p wa -k lk_cron
-w /etc/systemd/system -p wa -k lk_systemd
-w /usr/local/sbin -p wa -k lk_programs
-w /usr/local/bin -p wa -k lk_programs

## Docker's settings, the program loader, the kernel's settings, package sources
-w /etc/docker -p wa -k lk_docker
-w /etc/ld.so.preload -p wa -k lk_preload
-w /etc/ld.so.conf -p wa -k lk_preload
-w /etc/ld.so.conf.d -p wa -k lk_preload
-w /etc/sysctl.conf -p wa -k lk_kernel
-w /etc/sysctl.d -p wa -k lk_kernel
-w /etc/modprobe.d -p wa -k lk_kernel
-w /etc/apt/sources.list.d -p wa -k lk_apt
-w /etc/apt/apt.conf.d -p wa -k lk_apt
-w /etc/apt/keyrings -p wa -k lk_apt
-w /etc/audit -p wa -k lk_audit
-w /etc/latchkey-sentinel.json -p wa -k lk_audit

## Kernel modules loaded or removed (also by 32-bit calls)
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k lk_modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k lk_modules

## Every command run as root by someone who signed in (a record of each session)
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -k lk_root_exec
-a always,exit -F arch=b32 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -k lk_root_exec

## Locked: changing these rules takes a reboot, which the sentinel's heartbeat shows
-e 2
