# Latchkey: the sentinel (sentinel.py), installed by deploy/harden.sh.
[Unit]
Description=Latchkey sentinel (intrusion detection, reports to Cloud Logging)
After=network-online.target docker.service auditd.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/sbin/latchkey-sentinel
Restart=always
RestartSec=5
Nice=10
MemoryMax=96M
ProtectSystem=strict
ReadWritePaths=/var/lib/latchkey-sentinel
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
