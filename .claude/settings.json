{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud-setup.sh || true",
            "timeout": 590,
            "statusMessage": "Setting up a cloud session's tools"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-security@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  }
}
